{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "aftercare-interactRequest": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "skill_id": {
          "const": "aftercare-interact"
        },
        "skill_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "expected_task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": [
            "self",
            "guided",
            "auto"
          ]
        },
        "task_snapshot": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "kind": {
              "const": "TaskSnapshot"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "revision"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "object",
          "properties": {
            "goal_step": {
              "$ref": "#/$defs/Step"
            },
            "platform_view": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "PlatformView"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            "source_artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "TaskIntent",
                      "OrderSelection",
                      "RemedyPlan",
                      "EvidenceBundle",
                      "RecoveryPlan",
                      "ResumePlan",
                      "LogisticsPlan",
                      "AppealDraft",
                      "HandoffDraft"
                    ]
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "artifact_id",
                  "kind",
                  "revision"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "goal_step",
            "platform_view",
            "source_artifacts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "skill_id",
        "skill_version",
        "call_id",
        "task_id",
        "expected_task_revision",
        "mode",
        "task_snapshot",
        "inputs"
      ],
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "next_skill_hint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "intent",
        "reason",
        "required_evidence",
        "next_skill_hint"
      ],
      "additionalProperties": false
    },
    "aftercare-interactResult": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "skill_id": {
          "const": "aftercare-interact"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "based_on_task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "needs_user",
            "needs_observation",
            "blocked",
            "failed"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/InteractionPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Question"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "user_message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract_version",
        "skill_id",
        "call_id",
        "task_id",
        "based_on_task_revision",
        "status",
        "data",
        "questions",
        "issues",
        "user_message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/InteractionPlan"
              },
              "questions": {
                "maxItems": 0
              },
              "issues": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_user"
              }
            }
          },
          "then": {
            "properties": {
              "questions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "needs_observation",
                  "blocked",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "InteractionPlan": {
      "type": "object",
      "properties": {
        "presentation": {
          "type": "string",
          "enum": [
            "explain_only",
            "highlight",
            "propose_action"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "highlight_control_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "refresh_required": {
          "type": "boolean"
        }
      },
      "required": [
        "presentation",
        "instruction",
        "highlight_control_ref",
        "actions",
        "refresh_required"
      ],
      "additionalProperties": false
    },
    "Action": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "target_item_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "navigate",
            "expand",
            "fill",
            "select",
            "attach",
            "submit",
            "withdraw",
            "accept_offer",
            "book_pickup",
            "send_message"
          ]
        },
        "observation_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "page_revision": {
          "type": "integer",
          "minimum": 0
        },
        "control_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "value_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "effect": {
          "type": "string",
          "enum": [
            "read_only",
            "local_edit",
            "external_write",
            "unknown"
          ]
        },
        "recipient_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "material_content_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "minItems": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "proposal_id",
        "task_id",
        "target_item_ref",
        "operation",
        "observation_id",
        "page_revision",
        "control_ref",
        "value_refs",
        "effect",
        "recipient_ref",
        "material_content_ref",
        "evidence_refs",
        "expected_result"
      ],
      "additionalProperties": false
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "question_id",
        "text",
        "choices"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "missing_input",
            "stale_observation",
            "target_unconfirmed",
            "policy_unknown",
            "needs_login",
            "needs_consent",
            "unsupported",
            "ambiguous_result",
            "budget_exhausted",
            "contract_error",
            "tool_failure",
            "user_paused"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "aftercare-verifyRequest": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "skill_id": {
          "const": "aftercare-verify"
        },
        "skill_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "expected_task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": [
            "self",
            "guided",
            "auto"
          ]
        },
        "task_snapshot": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "kind": {
              "const": "TaskSnapshot"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "revision"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "object",
          "properties": {
            "platform_view": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "PlatformView"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            "receipt": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                    },
                    "kind": {
                      "const": "ExecutionReceipt"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "artifact_id",
                    "kind",
                    "revision"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "ledger": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "OperationLedger"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "platform_view",
            "receipt",
            "ledger"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "skill_id",
        "skill_version",
        "call_id",
        "task_id",
        "expected_task_revision",
        "mode",
        "task_snapshot",
        "inputs"
      ],
      "additionalProperties": false
    },
    "ExecutionReceipt": {
      "type": "object",
      "properties": {
        "execution_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "proposal_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "target_item_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "action_payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirmation_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "page_revision": {
          "type": "integer",
          "minimum": 0
        },
        "dispatch_state": {
          "type": "string",
          "enum": [
            "not_sent",
            "sent",
            "unknown"
          ]
        },
        "tool_state": {
          "type": "string",
          "enum": [
            "not_started",
            "running",
            "succeeded",
            "failed",
            "unknown"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "execution_id",
        "proposal_id",
        "task_id",
        "target_item_ref",
        "action_payload_digest",
        "confirmation_ref",
        "observation_id",
        "page_revision",
        "dispatch_state",
        "tool_state",
        "started_at",
        "finished_at",
        "result_evidence_refs"
      ],
      "additionalProperties": false
    },
    "OperationLedger": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "ledger_revision": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              },
              "event_type": {
                "type": "string",
                "enum": [
                  "planned",
                  "authorized",
                  "dispatch_started",
                  "tool_returned",
                  "verified",
                  "paused",
                  "resumed",
                  "mode_changed",
                  "target_changed"
                ]
              },
              "execution_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                }
              }
            },
            "required": [
              "event_id",
              "occurred_at",
              "event_type",
              "execution_ref",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "task_id",
        "ledger_revision",
        "events"
      ],
      "additionalProperties": false
    },
    "TaskSnapshot": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "target_item_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "intent_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "TaskIntent"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "remedy_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "RemedyPlan"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "OutcomeReport"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
