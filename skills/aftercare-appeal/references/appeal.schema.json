{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aftercare:skill-contracts:1.0.0#aftercare-appeal",
  "title": "Derived aftercare-appeal contract excerpt",
  "$defs": {
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "question_id",
        "text",
        "choices"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "missing_input",
            "stale_observation",
            "target_unconfirmed",
            "policy_unknown",
            "needs_login",
            "needs_consent",
            "unsupported",
            "ambiguous_result",
            "budget_exhausted",
            "contract_error",
            "tool_failure",
            "user_paused"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Fact": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "minItems": 1
        },
        "certainty": {
          "type": "string",
          "enum": [
            "observed",
            "user_reported",
            "inferred"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "evidence_refs",
        "certainty"
      ],
      "additionalProperties": false
    },
    "AppealDraft": {
      "type": "object",
      "properties": {
        "reason_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "grounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "draft_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "file_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "available_route_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "prepare",
            "collect_more",
            "handoff",
            "stop"
          ]
        }
      },
      "required": [
        "reason_evidence_refs",
        "grounds",
        "draft_text",
        "file_refs",
        "missing_evidence",
        "available_route_refs",
        "recommendation"
      ],
      "additionalProperties": false
    },
    "aftercare-appealRequest": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "skill_id": {
          "const": "aftercare-appeal"
        },
        "skill_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "expected_task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": [
            "self",
            "guided",
            "auto"
          ]
        },
        "task_snapshot": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "kind": {
              "const": "TaskSnapshot"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "revision"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "OutcomeReport"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            "platform_view": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "PlatformView"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            "evidence": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "EvidenceBundle"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            "ledger": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "OperationLedger"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "outcome",
            "platform_view",
            "evidence",
            "ledger"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "skill_id",
        "skill_version",
        "call_id",
        "task_id",
        "expected_task_revision",
        "mode",
        "task_snapshot",
        "inputs"
      ],
      "additionalProperties": false
    },
    "aftercare-appealResult": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "skill_id": {
          "const": "aftercare-appeal"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "based_on_task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "needs_user",
            "needs_observation",
            "blocked",
            "failed"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppealDraft"
            },
            {
              "type": "null"
            }
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Question"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "user_message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract_version",
        "skill_id",
        "call_id",
        "task_id",
        "based_on_task_revision",
        "status",
        "data",
        "questions",
        "issues",
        "user_message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/AppealDraft"
              },
              "questions": {
                "maxItems": 0
              },
              "issues": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_user"
              }
            }
          },
          "then": {
            "properties": {
              "questions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "needs_observation",
                  "blocked",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
