{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aftercare:intake-extract:1.0.0",
  "$defs": {
    "Fact": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "minItems": 1
        },
        "certainty": {
          "type": "string",
          "enum": [
            "observed",
            "user_reported",
            "inferred"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "evidence_refs",
        "certainty"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "missing_input",
            "stale_observation",
            "target_unconfirmed",
            "policy_unknown",
            "needs_login",
            "needs_consent",
            "unsupported",
            "ambiguous_result",
            "budget_exhausted",
            "contract_error",
            "tool_failure",
            "user_paused"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "question_id",
        "text",
        "choices"
      ],
      "additionalProperties": false
    },
    "TaskIntent": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "single_item_single_case"
        },
        "user_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "requested_outcome": {
          "type": "string",
          "enum": [
            "refund_only",
            "return_refund",
            "undecided"
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "goal",
        "scope",
        "user_facts",
        "requested_outcome",
        "missing_fields"
      ],
      "additionalProperties": false
    },
    "TaskSnapshot": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "target_item_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "intent_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "TaskIntent"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "remedy_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "RemedyPlan"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "OutcomeReport"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "self",
            "guided",
            "auto"
          ]
        },
        "paused": {
          "type": "boolean"
        },
        "remaining_budget": {
          "type": "object",
          "properties": {
            "actions": {
              "type": "integer",
              "minimum": 0
            },
            "recovery_attempts": {
              "type": "integer",
              "minimum": 0
            },
            "deadline_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "actions",
            "recovery_attempts",
            "deadline_at"
          ],
          "additionalProperties": false
        },
        "scope_grant_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "pending_execution_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "related_artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "task_id",
        "task_revision",
        "target_item_ref",
        "selection_receipt_ref",
        "intent_ref",
        "remedy_ref",
        "outcome_ref",
        "mode",
        "paused",
        "remaining_budget",
        "scope_grant_refs",
        "pending_execution_refs",
        "related_artifact_refs"
      ],
      "additionalProperties": false
    },
    "UserTurn": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "channel": {
          "type": "string",
          "enum": [
            "text",
            "asr"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "audio_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "transfer_grant_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recognition_uncertain": {
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "task_id",
        "occurred_at",
        "channel",
        "text",
        "audio_ref",
        "transfer_grant_ref",
        "recognition_uncertain"
      ],
      "additionalProperties": false
    },
    "aftercare-intakeRequest": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "skill_id": {
          "const": "aftercare-intake"
        },
        "skill_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "expected_task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": [
            "self",
            "guided",
            "auto"
          ]
        },
        "task_snapshot": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "kind": {
              "const": "TaskSnapshot"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "revision"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "object",
          "properties": {
            "user_turn": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "UserTurn"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "user_turn"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "skill_id",
        "skill_version",
        "call_id",
        "task_id",
        "expected_task_revision",
        "mode",
        "task_snapshot",
        "inputs"
      ],
      "additionalProperties": false
    },
    "aftercare-intakeResult": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "skill_id": {
          "const": "aftercare-intake"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "based_on_task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "needs_user",
            "needs_observation",
            "blocked",
            "failed"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskIntent"
            },
            {
              "type": "null"
            }
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Question"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "user_message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract_version",
        "skill_id",
        "call_id",
        "task_id",
        "based_on_task_revision",
        "status",
        "data",
        "questions",
        "issues",
        "user_message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/TaskIntent"
              },
              "questions": {
                "maxItems": 0
              },
              "issues": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_user"
              }
            }
          },
          "then": {
            "properties": {
              "questions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "needs_observation",
                  "blocked",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
