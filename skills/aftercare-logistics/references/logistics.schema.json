{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "aftercare-logisticsRequest": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "skill_id": {
          "const": "aftercare-logistics"
        },
        "skill_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "expected_task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": [
            "self",
            "guided",
            "auto"
          ]
        },
        "task_snapshot": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "kind": {
              "const": "TaskSnapshot"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "revision"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "object",
          "properties": {
            "order": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "OrderSelection"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            "remedy": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "RemedyPlan"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            "outcome": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "OutcomeReport"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            "platform_view": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "PlatformView"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            "user_decision": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                    },
                    "kind": {
                      "const": "UserDecision"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "artifact_id",
                    "kind",
                    "revision"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "order",
            "remedy",
            "outcome",
            "platform_view",
            "user_decision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "skill_id",
        "skill_version",
        "call_id",
        "task_id",
        "expected_task_revision",
        "mode",
        "task_snapshot",
        "inputs"
      ],
      "additionalProperties": false
    },
    "aftercare-logisticsResult": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "skill_id": {
          "const": "aftercare-logistics"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "based_on_task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "needs_user",
            "needs_observation",
            "blocked",
            "failed"
          ]
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/LogisticsPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Question"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "user_message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract_version",
        "skill_id",
        "call_id",
        "task_id",
        "based_on_task_revision",
        "status",
        "data",
        "questions",
        "issues",
        "user_message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/LogisticsPlan"
              },
              "questions": {
                "maxItems": 0
              },
              "issues": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_user"
              }
            }
          },
          "then": {
            "properties": {
              "questions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "needs_observation",
                  "blocked",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "LogisticsPlan": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "not_ready",
            "prepare_pickup",
            "await_user_shipping",
            "tracking",
            "problem"
          ]
        },
        "address_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_slot_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fee": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "fee_known": {
          "type": "boolean"
        },
        "tracking_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_todos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      },
      "required": [
        "stage",
        "address_ref",
        "time_slot_ref",
        "fee",
        "fee_known",
        "tracking_ref",
        "user_todos",
        "next_steps"
      ],
      "additionalProperties": false
    },
    "Money": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "currency",
        "minor_units"
      ],
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "next_skill_hint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "intent",
        "reason",
        "required_evidence",
        "next_skill_hint"
      ],
      "additionalProperties": false
    },
    "Question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "question_id",
        "text",
        "choices"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "missing_input",
            "stale_observation",
            "target_unconfirmed",
            "policy_unknown",
            "needs_login",
            "needs_consent",
            "unsupported",
            "ambiguous_result",
            "budget_exhausted",
            "contract_error",
            "tool_failure",
            "user_paused"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "TaskSnapshot": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "task_revision": {
          "type": "integer",
          "minimum": 0
        },
        "target_item_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "intent_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "TaskIntent"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "remedy_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "RemedyPlan"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                },
                "kind": {
                  "const": "OutcomeReport"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "self",
            "guided",
            "auto"
          ]
        },
        "paused": {
          "type": "boolean"
        },
        "remaining_budget": {
          "type": "object",
          "properties": {
            "actions": {
              "type": "integer",
              "minimum": 0
            },
            "recovery_attempts": {
              "type": "integer",
              "minimum": 0
            },
            "deadline_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "actions",
            "recovery_attempts",
            "deadline_at"
          ],
          "additionalProperties": false
        },
        "scope_grant_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "pending_execution_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "related_artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "task_id",
        "task_revision",
        "target_item_ref",
        "selection_receipt_ref",
        "intent_ref",
        "remedy_ref",
        "outcome_ref",
        "mode",
        "paused",
        "remaining_budget",
        "scope_grant_refs",
        "pending_execution_refs",
        "related_artifact_refs"
      ],
      "additionalProperties": false
    },
    "OrderSelection": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Candidate"
          }
        },
        "selected_item_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lookup_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      },
      "required": [
        "candidates",
        "selected_item_ref",
        "selection_receipt_ref",
        "lookup_steps"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "item_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "display_label": {
          "type": "string",
          "minLength": 1
        },
        "order_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "item_ref",
        "display_label",
        "order_ref",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "RemedyPlan": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "recommended_option_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "chosen_option_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "choice_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "material_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      },
      "required": [
        "options",
        "recommended_option_id",
        "chosen_option_id",
        "choice_receipt_ref",
        "material_requirements",
        "next_steps"
      ],
      "additionalProperties": false
    },
    "Option": {
      "type": "object",
      "properties": {
        "option_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "refund_only",
            "return_refund",
            "supplement",
            "appeal",
            "withdraw",
            "accept_offer",
            "contact_support"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "consequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "missing_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "option_id",
        "kind",
        "explanation",
        "conditions",
        "consequences",
        "missing_facts"
      ],
      "additionalProperties": false
    },
    "Fact": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "minItems": 1
        },
        "certainty": {
          "type": "string",
          "enum": [
            "observed",
            "user_reported",
            "inferred"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "evidence_refs",
        "certainty"
      ],
      "additionalProperties": false
    },
    "OutcomeReport": {
      "type": "object",
      "properties": {
        "platform_state": {
          "type": "string",
          "enum": [
            "not_started",
            "draft",
            "submitted",
            "pending",
            "needs_evidence",
            "return_required",
            "pickup_booked",
            "in_transit",
            "refund_processing",
            "refund_reported_complete",
            "rejected",
            "closed",
            "unknown"
          ]
        },
        "effect_result": {
          "type": "string",
          "enum": [
            "not_attempted",
            "confirmed_success",
            "confirmed_failure",
            "unknown"
          ]
        },
        "stage_complete": {
          "type": "boolean"
        },
        "case_terminal": {
          "type": "boolean"
        },
        "business_result": {
          "type": "string",
          "enum": [
            "not_final",
            "refund_reported",
            "final_rejection",
            "user_withdrawn",
            "other_final",
            "unknown"
          ]
        },
        "actual_receipt_confirmed": {
          "type": "string",
